// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- NextAuth required tables ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Application models ---

// Role values: ADMIN | EMPLOYEE
model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String?
  role     String  @default("EMPLOYEE")

  accounts Account[]
  sessions Session[]
  employee Employee?
}

model Employee {
  id            String @id @default(cuid())
  name          String
  userId        String @unique
  rotationOrder Int

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftAssignments ShiftAssignment[]
  changeLogs       ShiftChangeLog[]
}

// ShiftType values: M | T | N | J | D | V | B | MF | TF | NF
model ShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime
  shiftType  String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model Schedule {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  generatedAt DateTime @default(now())

  @@unique([month, year])
}

// Días festivos (nacionales)
model Holiday {
  id          String   @id @default(cuid())
  date        DateTime // UTC midnight del día festivo
  description String
  year        Int      // año duplicado para filtrar fácilmente

  @@unique([date])
}

// Registro de cambios manuales de turno
model ShiftChangeLog {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime // fecha del turno modificado
  oldShift   String?  // null si es una asignación nueva
  newShift   String
  changedBy  String   // email del usuario que hizo el cambio
  changedAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}
