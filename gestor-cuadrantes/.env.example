# ============================================================
# BASE DE DATOS
# ============================================================

# Desarrollo local (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Producción (PostgreSQL) — descomentar y rellenar en servidor
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gestor_cuadrantes?schema=public"

# ============================================================
# NEXTAUTH
# ============================================================

# URL base de la aplicación (sin barra final)
NEXTAUTH_URL="http://localhost:3000"

# Secreto para firmar los tokens de sesión.
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET"

# ============================================================
# PRODUCCIÓN (PostgreSQL) — requerido con docker-compose.prod.yml
# ============================================================

# POSTGRES_USER="gestor"
# POSTGRES_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
# POSTGRES_DB="gestor_cuadrantes"
# DATABASE_URL="postgresql://gestor:REPLACE_WITH_STRONG_PASSWORD@db:5432/gestor_cuadrantes"
