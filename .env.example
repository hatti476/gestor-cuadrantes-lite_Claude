# ============================================================
# BASE DE DATOS
# ============================================================

# Desarrollo local (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Producción con docker-compose.prod.yml (SQLite, mismo provider que
# desarrollo — la app es mono-inquilino). No hace falta cambiar esta
# variable aquí: docker-compose.prod.yml ya fija DATABASE_URL a
# file:/app/data/prod.db dentro del contenedor.

# ============================================================
# NEXTAUTH
# ============================================================

# URL base de la aplicación (sin barra final). El puerto 3000 queda
# reservado para el contenedor de producción (docker-compose.prod.yml) —
# `npm run dev` arranca en el 3100 para no mezclarse con él.
NEXTAUTH_URL="http://localhost:3100"

# Secreto para firmar los tokens de sesión.
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET"
